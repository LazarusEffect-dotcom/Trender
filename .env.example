# Optional Supabase browser client. The app can run without Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Add this in Vercel Project Settings → Environment Variables.
# Never prefix this value with VITE_ and never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
