# Optional Supabase browser client. The app can run without Supabase.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only. Add these in Vercel Project Settings → Environment Variables.
# Never prefix the API key with VITE_ or commit a real key.
OPENROUTER_API_KEY=
# Optional. This free-only fallback order is also used automatically when unset.
# OpenRouter rotates its free-model router, then tries the listed free endpoints.
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
# Used for OpenRouter app attribution; update if you use a custom domain.
OPENROUTER_SITE_URL=https://trender-xi.vercel.app
