# Optional Supabase client configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side AI Keys (configure in your local .env.local or in Vercel Project Settings)
# Trender Intelligence automatically supports Google Gemini, OpenRouter, and OpenAI.
# When unset, Trender uses the built-in Grounded Local Analyst engine.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional OpenRouter custom attribution
OPENROUTER_SITE_URL=https://trender-xi.vercel.app
